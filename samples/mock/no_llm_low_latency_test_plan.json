{
  "schema": "dv.no-llm-low-latency-test-plan.1",
  "description": "Fixed golden queries and load profiles for low-latency MATCH_WORDS and Query Recall collection without LLM participation.",
  "llm": {
    "enabled": false,
    "enforcement": [
      "QueryRecallFacade is invoked with use_llm=false for every request",
      "EntityLinkingModule is assembled without an extraction enhancer",
      "EntityLinkingModule is assembled without a candidate reranker"
    ]
  },
  "profiles": {
    "smoke": {
      "duration_seconds": 5,
      "concurrencies": [1, 10],
      "warmups_per_worker": 1
    },
    "analysis": {
      "duration_seconds": 120,
      "concurrencies": [1, 10, 25, 50, 100],
      "warmups_per_worker": 2
    },
    "formal": {
      "duration_seconds": 900,
      "concurrencies": [1, 10, 25, 50, 100],
      "warmups_per_worker": 3
    }
  },
  "cases": [
